# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.next-standalone-tmp/
# 本机构建前会把 .next 改名成 .next-old-<stamp>（Windows 沙箱禁止批量删除），
# 不忽略的话每构建一次就在 git status 里多出一整棵树。
/.next-old-*/
/.next.new-*/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Temp files
check-colors.js
__pycache__/
dom-dump*.txt
parse_api.py
test_api.py
screenshot-*.png
screenshot-full.png
/screenshots/
.gitignore.tmp

# Deploy artifacts
*.zip
*.tar.gz
standalone-*
.omx/
patches/

# Internal planning docs
DESIGN.md
NEOMORPHISM-PLAN.md
ai-art-integration_*.md
/audit-results/

# Deploy stages and archives
.deploy-stage*
*.tar
deploy_tmp/
.ui-batch1*
audit-ux*

