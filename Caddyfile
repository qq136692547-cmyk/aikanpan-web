{
	email admin@aikanpan.top
}

aikanpan.top, www.aikanpan.top {
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-RateLimit-Limit "120"
		X-RateLimit-Remaining "119"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; connect-src 'self' https:; frame-ancestors 'self'"
		RateLimit-Limit "120"
		RateLimit-Remaining "119"
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
		format json
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle /_next/static/* {
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_down Cache-Control "no-cache, no-store, must-revalidate"
		}
	}
}
